{
  "expo": {
    "name": "rotina",
    "slug": "rotina",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rotina",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151312",
    "android": {
      "package": "com.rotina.app",
      "backgroundColor": "#151312"
    },
    "ios": {
      "bundleIdentifier": "com.rotina.app",
      "backgroundColor": "#151312"
    },
    "web": {
      "output": "server"
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "447c604d-74ae-4c00-bf8a-a6b433dad322"
      }
    },
    "owner": "alvarokaycss"
  }
}
