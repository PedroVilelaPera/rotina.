{
  "expo": {
    "name": "rotina.",
    "slug": "rotina",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rotina",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#151312",
    "android": {
      "package": "com.rotina.app",
      "backgroundColor": "#151312"
    },
    "ios": {
      "bundleIdentifier": "com.rotina.app",
      "backgroundColor": "#151312"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
